@model MZWlyt.Models.tb_user

@{
    ViewBag.Title = "Delete";
}

<h2>删除用户</h2>

<div class="detail-card">
    <div class="detail-item">
        <span class="detail-label">@Html.DisplayNameFor(model => model.uname)</span>
        <span class="detail-value">@Html.DisplayFor(model => model.uname)</span>
    </div>
    <div class="detail-item">
        <span class="detail-label">@Html.DisplayNameFor(model => model.password)</span>
        <span class="detail-value">@Html.DisplayFor(model => model.password)</span>
    </div>
    <div class="detail-item">
        <span class="detail-label">@Html.DisplayNameFor(model => model.address)</span>
        <span class="detail-value">@Html.DisplayFor(model => model.address)</span>
    </div>
    <div class="detail-item">
        <span class="detail-label">@Html.DisplayNameFor(model => model.tel)</span>
        <span class="detail-value">@Html.DisplayFor(model => model.tel)</span>
    </div>
    <div class="detail-item">
        <span class="detail-label">@Html.DisplayNameFor(model => model.email)</span>
        <span class="detail-value">@Html.DisplayFor(model => model.email)</span>
    </div>
    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()
        <div class="form-actions">
            <input type="submit" value="删除" class="btn btn-danger" onclick="return confirm('确定要删除吗？')" />
            @Html.ActionLink("返回首页", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>