@model MZWlyt.Models.tb_product

@{
    ViewBag.Title = "删除商品";
}

<h2>删除商品</h2>

<div class="alert alert-warning">
    <strong>警告：</strong> 确定要删除此商品吗？此操作无法撤销！
</div>

<div class="row">
    <div class="col-md-4">
        @{
            var photoPath = Model.photo != null ? Model.photo.Trim().Replace(" ", "") : "";
        }
        @if (!string.IsNullOrEmpty(photoPath))
        {
            <img src="@photoPath" alt="@Model.pname" class="img-responsive img-thumbnail" style="max-width:100%; max-height:300px;" />
        }
        else
        {
            <div class="thumbnail" style="width:200px; height:200px; display:flex; align-items:center; justify-content:center; background-color:#f5f5f5;">
                <span class="text-muted">暂无图片</span>
            </div>
        }
    </div>
    <div class="col-md-8">
        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.pname)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.pname)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.price)
            </dt>

            <dd>
                <span class="text-danger">¥@Html.DisplayFor(model => model.price)</span>
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.pnums)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.pnums) 件
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.salenums)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.salenums) 件
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.mess)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.mess)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.state)
            </dt>

            <dd>
                @if (Model.state == "有货")
                {
                    <span class="label label-success">有货</span>
                }
                else
                {
                    <span class="label label-default">无货</span>
                }
            </dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="确认删除" class="btn btn-danger" />
                @Html.ActionLink("返回列表", "Index", "Product", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>
