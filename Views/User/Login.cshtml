@model MZWlyt.Models.tb_user

@{
    ViewBag.Title = "登录";
}

<h2>用户登录</h2>

<div class="login-wrapper">
    <div class="login-container">
        <div class="login-card">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="login-form">
                    <div class="form-group">
                        @Html.LabelFor(model => model.uname, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.uname, new { htmlAttributes = new { @class = "form-control", placeholder = "请输入用户名" } })
                        @Html.ValidationMessageFor(model => model.uname, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.password, htmlAttributes: new { @class = "control-label" })
                        @Html.EditorFor(model => model.password, new { htmlAttributes = new { @class = "form-control", placeholder = "请输入密码" } })
                        @Html.ValidationMessageFor(model => model.password, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-actions" style="display: block;">
                        <input type="submit" value="会员登录" class="btn-login" style="width: auto; padding: 12px 32px;" />
                        @Html.ActionLink("管理员登录", "Login", "admin", null, new { @class = "btn btn-default", style = "padding: 12px 32px; margin-left: 12px;" })
                    </div>
                </div>
            }

            @* 移除了这里的 login-links div *@
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
